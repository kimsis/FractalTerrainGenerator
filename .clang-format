---
BasedOnStyle: Google
Language: Cpp

IndentWidth: 4
ColumnLimit: 150
PointerAlignment: Left
BreakBeforeBraces: Attach

# Google's default is 2; keep the more common 1-space gap before trailing comments.
SpacesBeforeTrailingComments: 1

# Trailing commas, never leading commas, in braced init lists.
Cpp11BracedListStyle: true

# When a call/struct-init doesn't fit on one line, put exactly one
# argument/member per line instead of packing several per line.
BinPackArguments: false
BinPackParameters: false
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false
AlignAfterOpenBracket: BlockIndent
...
